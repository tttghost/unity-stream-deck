          "Image": "imgs/keys/console",
          "Title": "콘솔 상태",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        }
