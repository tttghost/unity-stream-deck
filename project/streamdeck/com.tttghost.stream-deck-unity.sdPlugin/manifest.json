  "Icon": "imgs/plugin/unity",
  "Name": "스트림덱 유니티",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "com.tttghost.stream-deck-unity",
  "Version": "0.3.1.0"
