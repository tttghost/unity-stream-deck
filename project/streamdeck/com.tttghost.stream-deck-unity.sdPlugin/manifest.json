        {
          "Image": "imgs/keys/clear",
          "Title": "콘솔 지우기",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        }
      ],
      "Tooltip": "Unity 콘솔을 지웁니다",
      "UUID": "com.tttghost.stream-deck-unity.console-clear"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/unity-editor/build",
