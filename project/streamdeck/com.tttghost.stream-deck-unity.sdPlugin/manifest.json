{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/actions/separator",
      "Name": "── 플레이 모드 ──",
      "States": [
        {
          "Image": "imgs/actions/separator",
          "Title": "",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": false
        }
      ],
      "Tooltip": "기능 구분용 라벨",
      "UUID": "com.tttghost.stream-deck-unity.separator.play-mode"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/unity-editor/play",
      "Name": "플레이 / 정지",
      "States": [
        {
          "Image": "imgs/keys/play",
          "Name": "정지 - 플레이",
          "Title": "플레이",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        },
        {
          "Image": "imgs/keys/stop",
          "Name": "실행 중 - 정지",
          "Title": "정지",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        }
      ],
      "Tooltip": "정지 상태에서는 플레이하고 실행 중에는 정지합니다",
      "UUID": "com.tttghost.stream-deck-unity.play-stop-toggle",
      "DisableAutomaticStates": true
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/unity-editor/pause",
      "Name": "일시정지 / 재개",
      "States": [
        {
          "Image": "imgs/keys/pause",
          "Name": "실행 중 - 일시정지",
          "Title": "일시정지",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        },
        {
          "Image": "imgs/keys/play",
          "Name": "일시정지 - 재개",
          "Title": "재개",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": true
        }
      ],
      "Tooltip": "Unity 일시정지와 재개를 전환합니다",
      "UUID": "com.tttghost.stream-deck-unity.pause",
      "DisableAutomaticStates": true
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "imgs/actions/separator",
      "Name": "── 캡처 ──",
      "States": [
        {
          "Image": "imgs/actions/separator",
          "Title": "",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 11,
          "FontStyle": "Bold",
          "ShowTitle": false
